{
  "expo": {
    "name": "SLP AI",
    "slug": "slp-ai",
    "scheme": "slpai",
    "version": "1.0.4",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FCFAF7",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.heonhwi.slpai"
    },
    "android": {
      "package": "dev.heonhwi.slpai",
      "versionCode": 12,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FCFAF7"
      },
      "softwareKeyboardLayoutMode": "resize",
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "backgroundColor": "#FCFAF7"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "수업 녹음을 기록으로 만들기 위해 마이크를 사용합니다.",
          "recordAudioAndroid": true,
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-asset",
      "./plugins/with-system-bars",
      [
        "react-native-android-widget",
        {
          "widgets": [
            {
              "name": "ScheduleCompact",
              "label": "SLP AI 다음 수업",
              "description": "본인의 다음 수업과 오늘 수업 수",
              "minWidth": "320dp",
              "minHeight": "110dp",
              "targetCellWidth": 4,
              "targetCellHeight": 2,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            },
            {
              "name": "ScheduleAgenda",
              "label": "SLP AI 오늘 일정",
              "description": "본인의 오늘 수업 목록",
              "minWidth": "320dp",
              "minHeight": "250dp",
              "targetCellWidth": 4,
              "targetCellHeight": 4,
              "resizeMode": "horizontal|vertical",
              "widgetCategory": "home_screen",
              "updatePeriodMillis": 1800000
            }
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
