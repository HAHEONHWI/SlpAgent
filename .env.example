ENV=development
AUTH_MODE=dev            # dev is rejected when ENV=production
STORAGE_BACKEND=memory   # firestore in production
OPENAI_API_KEY=          # Secret Manager in production
OPENAI_MODEL=            # set to a model your account supports; not hardcoded
OPENAI_EMBEDDING_MODEL=  # optional; omit for Korean character-bigram retrieval
OPENAI_ALLOW_REFERENCE_EMBEDDING_UPLOAD=false # copyright text upload requires explicit approval
GCS_BUCKET=              # private Cloud Storage bucket in production
DOCUMENT_URL_SIGNING_KEY= # set only for local signed file links
PDF_FONT_PATH=           # licensed Korean TTF/TTC; see docs/documents.md
HWPX_TEMPLATE_PATH=      # local template path; source template stays untracked
LOCAL_KNOWLEDGE_DIR=     # dev+memory only: e.g. ../extracted loads local 검사 서류 into AI 지식자료 (never uploaded)
GROQ_API_KEY=            # speech-to-text (Secret Manager in production)
STT_MODEL=whisper-large-v3-turbo
OPENROUTER_API_KEY=      # optional STT fallback
OPENROUTER_STT_MODEL=openai/whisper-large-v3-turbo
OPENROUTER_STT_USD_PER_HOUR=0.04
GROQ_AUDIO_SECONDS_PER_HOUR=0   # 0 = not enforced; production: 7200 (Groq free plan)
GROQ_AUDIO_SECONDS_PER_DAY=0    # production: 28800
RECORDINGS_BUCKET=       # empty = local directory
STT_TASKS_QUEUE=         # empty = in-process queue (dev)
